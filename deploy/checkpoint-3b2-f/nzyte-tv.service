[Unit]
Description=NZYTE TV Production Rolling Station
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/srv/nzyte-tv/media

[Service]
Type=simple
User=u24
Group=u24
EnvironmentFile=/etc/nzyte-tv/secrets.env
Environment=NZYTE_TV_BROADCAST_DIAGNOSTICS_PATH=/var/lib/nzyte-tv/broadcast-diagnostics.json
ExecStart=/opt/nzyte-tv/production/nzyte-tv-production-launch.sh
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=90
Restart=on-failure
RestartSec=5
RestartPreventExitStatus=78
StateDirectory=nzyte-tv
StateDirectoryMode=0750
UMask=0027

[Install]
WantedBy=multi-user.target
